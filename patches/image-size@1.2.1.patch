diff --git a/dist/types/icns.js b/dist/types/icns.js
index f2bfafef3723cb423b110304815e56e3f97f81e0..37beff38cdcb06b1e00cf879cd73d09313c3f072 100644
--- a/dist/types/icns.js
+++ b/dist/types/icns.js
@@ -82,7 +82,11 @@ exports.ICNS = {
         let imageOffset = SIZE_HEADER;
         let imageHeader = readImageHeader(input, imageOffset);
         let imageSize = getImageSize(imageHeader[0]);
-        imageOffset += imageHeader[1];
+        const firstEntryLength = imageHeader[1];
+        if (!Number.isFinite(firstEntryLength) || firstEntryLength < 8) {
+            return imageSize;
+        }
+        imageOffset += firstEntryLength;
         if (imageOffset === fileLength)
             return imageSize;
         const result = {
@@ -93,7 +97,12 @@ exports.ICNS = {
