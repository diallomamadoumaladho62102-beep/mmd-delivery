{
  "expo": {
    "name": "MMD Delivery",
    "slug": "mmd-delivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./apps/mobile/assets/icon.png",
    "splash": {
      "image": "./apps/mobile/assets/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.maladho2025.mmddelivery",
      "permissions": ["INTERNET"],
      "adaptiveIcon": {
        "foregroundImage": "./apps/mobile/assets/adaptive-icon.png",
        "monochromeImage": "./apps/mobile/assets/monochrome-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "bundleIdentifier": "com.maladho2025.mmddelivery",
      "icon": "./apps/mobile/assets/ios-marketing-icon.png",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "eas": {
        "projectId": "127751ea-33ce-4f67-98ce-a9b29a46b838"
      }
    }
  }
}
