{
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@mmd/platform-roles": [
        "../../shared/platformRoles.ts"
      ],
      "@mmd/social-links": [
        "../../shared/socialLinks.ts"
      ],
      "@mmd/profile-completeness": [
        "../../shared/profileCompleteness.ts"
      ],
      "@mmd/phone-verify-api": [
        "../../shared/phoneVerifyApi.ts"
      ]
    },
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.mts",
    "**/*.ts",
    "**/*.tsx",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "Backups",
    "src/__routes_backup__"
  ]
}